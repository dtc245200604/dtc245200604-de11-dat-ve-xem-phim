<%- include('../partials/header', {title: 'Quản trị rạp phim'}) %>
<% const stateLabels = {pending:'Chờ thanh toán',paid:'Đã thanh toán',failed:'Thất bại',expired:'Hết hạn'}; %>
<main id="noi-dung" class="container page-main admin-page"><%- include('../partials/admin-nav') %><div class="page-heading"><span class="eyebrow">TỔNG QUAN</span><h1>Quản lý rạp phim</h1><p>Cập nhật nội dung phim và lịch chiếu, theo dõi đơn đặt vé.</p></div>
  <div class="admin-stats"><div class="panel stat-item"><span>Phim trong hệ thống</span><strong><%= movies.length %></strong></div><div class="panel stat-item"><span>Suất chiếu</span><strong><%= showtimes.length %></strong></div><div class="panel stat-item"><span>Đơn được hiển thị</span><strong><%= bookings.length %></strong></div><div class="panel stat-item"><span>Đã thanh toán trong danh sách</span><strong><%= bookings.filter(b => b.status === 'paid').length %></strong></div></div>
  <section class="admin-section"><div class="section-heading"><h2>Danh sách phim</h2><a class="button button-small" href="/admin/movies/new">+ Thêm phim</a></div><div class="table-scroll panel"><table><caption class="sr-only">Danh sách phim trong hệ thống</caption><thead><tr><th>Phim</th><th>Thể loại</th><th>Thời lượng</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody><% movies.forEach(function(movie) { %><tr><td><div class="table-movie"><img src="/images/posters/<%= movie.posterKey %>.svg" alt="" width="600" height="800"><strong><%= movie.title %></strong></div></td><td><%= movie.genre %></td><td><%= movie.durationMinutes %> phút</td><td><span class="status-badge <%= movie.isActive ? 'status-paid' : 'status-expired' %>"><%= movie.isActive ? 'Đang hiển thị' : 'Đã ẩn' %></span></td><td><div class="table-actions"><a href="/admin/movies/<%= movie.id %>/edit" class="text-link">Sửa</a><% if (movie.isActive) { %><form method="post" action="/admin/movies/<%= movie.id %>/archive" data-confirm="Ẩn phim này khỏi danh sách đang chiếu?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" class="link-button">Ẩn phim</button></form><% } %></div></td></tr><% }); %><% if (!movies.length) { %><tr><td colspan="5" class="table-empty">Chưa có phim.</td></tr><% } %></tbody></table></div></section>
  <section class="admin-section"><div class="section-heading"><h2>Lịch chiếu</h2><a class="button button-small" href="/admin/showtimes/new">+ Thêm suất chiếu</a></div><div class="table-scroll panel"><table><caption class="sr-only">Lịch chiếu trong hệ thống</caption><thead><tr><th>Phim</th><th>Ngày giờ chiếu</th><th>Giá vé</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody><% showtimes.forEach(function(slot) { %><tr><td><strong><%= slot.title %></strong></td><td class="nowrap"><%= formatDateTime(slot.startsAt) %></td><td class="nowrap"><%= formatMoney(slot.price) %></td><td><span class="status-badge <%= slot.status === 'open' ? 'status-paid' : 'status-expired' %>"><%= slot.status === 'open' ? 'Mở đặt vé' : 'Đã đóng' %></span></td><td><div class="table-actions"><a href="/admin/showtimes/<%= slot.id %>/edit" class="text-link">Sửa</a><% if (slot.status === 'open') { %><form action="/admin/showtimes/<%= slot.id %>/close" method="post" data-confirm="Đóng đặt vé suất chiếu này?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="link-button" type="submit">Đóng</button></form><% } %></div></td></tr><% }); %><% if (!showtimes.length) { %><tr><td colspan="5" class="table-empty">Chưa có suất chiếu.</td></tr><% } %></tbody></table></div><p class="small-text muted">Suất chiếu đã có đơn đặt vé không được sửa thông tin. Hệ thống kiểm tra lịch trùng trong cùng phòng.</p></section>
  <section class="admin-section"><div class="section-heading"><h2>Đơn đặt vé gần đây</h2><span class="small-text muted">Theo thời gian tạo mới nhất</span></div><div class="table-scroll panel"><table><caption class="sr-only">Các đơn đặt vé gần đây</caption><thead><tr><th>Mã đơn / Thời gian</th><th>Phim / Suất chiếu</th><th>Người đặt</th><th>Tổng tiền</th><th>Trạng thái</th></tr></thead><tbody><% bookings.forEach(function(booking) { %><tr><td><strong class="order-code"><%= booking.code %></strong><span class="table-secondary"><%= formatDateTime(booking.createdAt) %></span></td><td><strong><%= booking.title %></strong><span class="table-secondary"><%= formatDateTime(booking.startsAt) %></span></td><td><%= booking.name %><span class="table-secondary"><%= booking.email %></span></td><td class="nowrap"><%= formatMoney(booking.total) %></td><td><span class="status-badge status-<%= booking.status %>"><%= stateLabels[booking.status] || booking.status %></span></td></tr><% }); %><% if (!bookings.length) { %><tr><td colspan="5" class="table-empty">Chưa có đơn đặt vé.</td></tr><% } %></tbody></table></div></section>
</main>
<%- include('../partials/footer', {scripts: ['/js/admin.js']}) %>
