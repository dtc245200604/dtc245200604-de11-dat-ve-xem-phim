<%- include('../partials/header', {title: 'Đăng nhập quản trị'}) %>
<main id="noi-dung" class="container page-main login-page"><section class="panel login-panel"><span class="eyebrow">KHU VỰC QUẢN TRỊ</span><h1>Chào mừng trở lại</h1><p>Đăng nhập để quản lý phim, suất chiếu và đơn đặt vé.</p><form action="/admin/login" method="post" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label for="username">Tên đăng nhập</label><input id="username" name="username" autocomplete="username" required maxlength="100" autofocus><label for="password">Mật khẩu</label><input id="password" name="password" type="password" autocomplete="current-password" required maxlength="200"><button class="button button-full" type="submit">Đăng nhập <span aria-hidden="true">→</span></button></form><a class="text-link" href="/">← Trở lại website</a></section></main>
<%- include('../partials/footer') %>
