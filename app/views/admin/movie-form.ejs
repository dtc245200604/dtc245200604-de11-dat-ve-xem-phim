<%- include('../partials/header', {title: movie ? 'Chỉnh sửa phim' : 'Thêm phim'}) %>
<main id="noi-dung" class="container page-main admin-page"><%- include('../partials/admin-nav') %><nav class="breadcrumb" aria-label="Đường dẫn"><a href="/admin">Quản trị</a><span aria-hidden="true">/</span><span><%= movie ? 'Chỉnh sửa phim' : 'Thêm phim' %></span></nav><div class="page-heading"><span class="eyebrow">NỘI DUNG PHIM</span><h1><%= movie ? 'Chỉnh sửa phim' : 'Thêm phim mới' %></h1><p>Thông tin này hiển thị trên website đặt vé.</p></div>
  <form action="/admin/movies<%= movie ? '/' + movie.id : '' %>" method="post" class="panel editor-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="form-grid"><div class="field field-full"><label for="title">Tên phim</label><input id="title" name="title" value="<%= movie ? movie.title : '' %>" required minlength="2" maxlength="160"></div><div class="field"><label for="genre">Thể loại</label><input id="genre" name="genre" value="<%= movie ? movie.genre : '' %>" placeholder="Ví dụ: Tâm lý, Gia đình" required minlength="2" maxlength="80"></div><div class="field"><label for="duration">Thời lượng (phút)</label><input id="duration" name="durationMinutes" type="number" min="30" max="240" step="1" value="<%= movie ? movie.durationMinutes : 100 %>" required></div><div class="field field-full"><label for="description">Nội dung phim</label><textarea id="description" name="description" rows="6" required minlength="10" maxlength="4000"><%= movie ? movie.description : '' %></textarea></div><fieldset class="poster-picker field-full"><legend>Áp phích</legend><div class="poster-options"><% [{key:'dawn',label:'Bình minh'},{key:'orbit',label:'Quỹ đạo'},{key:'river',label:'Dòng sông'},{key:'echo',label:'Tiếng vọng'}].forEach(function(poster, index) { %><label><input type="radio" name="posterKey" value="<%= poster.key %>" <%- (movie ? movie.posterKey === poster.key : index === 0) ? 'checked' : '' %> required><img src="/images/posters/<%= poster.key %>.svg" alt="Áp phích mẫu <%= poster.label %>" width="600" height="800"><span><%= poster.label %></span></label><% }); %></div></fieldset></div><div class="form-actions"><button type="submit" class="button"><%= movie ? 'Lưu thay đổi' : 'Thêm phim' %></button><a href="/admin" class="button button-outline">Hủy</a></div></form>
</main>
<%- include('../partials/footer') %>
