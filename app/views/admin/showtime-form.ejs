<%- include('../partials/header', {title: showtime ? 'Chỉnh sửa suất chiếu' : 'Thêm suất chiếu'}) %>
<% let startsAtInput = ''; if (showtime) { const parts = new Intl.DateTimeFormat('en-CA', {timeZone:'Asia/Ho_Chi_Minh',year:'numeric',month:'2-digit',day:'2-digit',hour:'2-digit',minute:'2-digit',hourCycle:'h23'}).formatToParts(new Date(showtime.startsAt)); const get = type => parts.find(p => p.type === type).value; startsAtInput = get('year') + '-' + get('month') + '-' + get('day') + 'T' + get('hour') + ':' + get('minute'); } %>
<main id="noi-dung" class="container page-main admin-page"><%- include('../partials/admin-nav') %><nav class="breadcrumb" aria-label="Đường dẫn"><a href="/admin">Quản trị</a><span aria-hidden="true">/</span><span><%= showtime ? 'Chỉnh sửa suất chiếu' : 'Thêm suất chiếu' %></span></nav><div class="page-heading"><span class="eyebrow">LỊCH PHÒNG CHIẾU 01</span><h1><%= showtime ? 'Chỉnh sửa suất chiếu' : 'Thêm suất chiếu mới' %></h1><p>Sắp xếp lịch chiếu cho phòng 48 ghế.</p></div>
  <form action="/admin/showtimes<%= showtime ? '/' + showtime.id : '' %>" method="post" class="panel editor-form narrow-editor"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="form-grid"><div class="field field-full"><label for="movie-id">Phim</label><select id="movie-id" name="movieId" required><option value="">Chọn phim</option><% movies.forEach(function(movie) { %><option value="<%= movie.id %>" <%- showtime && String(showtime.movieId) === String(movie.id) ? 'selected' : '' %>><%= movie.title %> · <%= movie.durationMinutes %> phút</option><% }); %></select></div><div class="field"><label for="starts-at">Ngày giờ bắt đầu</label><input id="starts-at" name="startsAt" type="datetime-local" value="<%= startsAtInput %>" required><p class="field-help">Nhập theo giờ Việt Nam (UTC+7).</p></div><div class="field"><label for="price">Giá vé mỗi ghế (VND)</label><input id="price" name="price" type="number" min="10000" max="1000000" step="1000" value="<%= showtime ? showtime.price : 75000 %>" required></div></div><div class="notice notice-info">Hệ thống không cho phép hai suất chiếu trùng thời gian trong cùng phòng. Suất chiếu đã có đơn đặt vé sẽ bị khóa chỉnh sửa.</div><div class="form-actions"><button type="submit" class="button"><%= showtime ? 'Lưu thay đổi' : 'Thêm suất chiếu' %></button><a class="button button-outline" href="/admin">Hủy</a></div></form>
</main>
<%- include('../partials/footer') %>
