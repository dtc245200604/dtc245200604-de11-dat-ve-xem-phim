<%- include('partials/header', {title: 'Vé của tôi', active: 'history'}) %>
<% const stateLabels = {pending:'Chờ thanh toán',paid:'Đã thanh toán',failed:'Thanh toán thất bại',expired:'Đã hết hạn'}; %>
<main id="noi-dung" class="container page-main">
  <nav class="breadcrumb" aria-label="Đường dẫn"><a href="/">Trang chủ</a><span aria-hidden="true">/</span><span>Vé của tôi</span></nav><div class="page-heading"><span class="eyebrow">NHỮNG CUỘC HẸN VỚI MÀN ẢNH</span><h1>Vé của tôi</h1><p>Các đơn đặt vé trong phiên trình duyệt hiện tại.</p></div>
  <% if (!bookings.length) { %><div class="panel empty-state history-empty"><span class="empty-icon" aria-hidden="true">▤</span><h2>Bạn chưa có đơn đặt vé nào</h2><p>Một bộ phim hay và chiếc ghế yêu thích đang chờ bạn.</p><a class="button" href="/#lich-chieu">Khám phá lịch chiếu <span aria-hidden="true">→</span></a></div><% } else { %>
    <div class="history-list"><% bookings.forEach(function(booking) { %><article class="panel history-card"><div class="history-card-main"><div class="history-order"><span class="eyebrow"><%= booking.code %></span><span class="status-badge status-<%= booking.status %>"><%= stateLabels[booking.status] || booking.status %></span></div><h2><%= booking.title %></h2><p><%= formatDateTime(booking.startsAt) %> <span aria-hidden="true">·</span> Phòng 01</p><p class="small-text muted">Đặt lúc <%= formatDateTime(booking.createdAt) %></p></div><div class="history-card-action"><strong><%= formatMoney(booking.total) %></strong><a class="button <%= booking.status === 'paid' ? '' : 'button-outline' %> button-small" href="/bookings/<%= booking.id %><%= booking.status === 'paid' ? '/ticket' : '' %>"><%= booking.status === 'paid' ? 'Xem vé' : booking.status === 'pending' ? 'Thanh toán' : 'Xem chi tiết' %><span aria-hidden="true">→</span></a></div></article><% }); %></div><p class="history-note">Phiên đặt vé được lưu bằng cookie trên trình duyệt. Nếu xóa cookie hoặc đổi trình duyệt, bạn sẽ không thấy các đơn này.</p>
  <% } %>
</main>
<%- include('partials/footer') %>
